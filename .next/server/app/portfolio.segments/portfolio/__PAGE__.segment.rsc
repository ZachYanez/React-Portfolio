10:["$","div",null,{"className":"projectDetailsGrid","children":[["$","div",null,{"className":"projectDetailBlock","children":[["$","p",null,{"className":"projectDetailLabel","children":"Features"}],["$","ul",null,{"className":"projectDetailList","children":[["$","li","Capture recipes from manual entry, narrated audio, video, OCR scans, social links, webpages, and prompt-driven generation.",{"children":"Capture recipes from manual entry, narrated audio, video, OCR scans, social links, webpages, and prompt-driven generation."}],["$","li","Meal planning for personal and household scopes with four-week browsing, quick adds, and Plan My Week previews.",{"children":"Meal planning for personal and household scopes with four-week browsing, quick adds, and Plan My Week previews."}],["$","li","Cooking mode with voice navigation, timers, text-to-speech, nutrition, and shopping-list generation.",{"children":"Cooking mode with voice navigation, timers, text-to-speech, nutrition, and shopping-list generation."}]]}]]}],["$","div",null,{"className":"projectDetailBlock","children":[["$","p",null,{"className":"projectDetailLabel","children":"Engineering"}],["$","ul",null,{"className":"projectDetailList","children":[["$","li","Expo Router + MobX mobile app backed by an Express TypeScript API and Supabase Postgres/Storage.",{"children":"Expo Router + MobX mobile app backed by an Express TypeScript API and Supabase Postgres/Storage."}],["$","li","OpenAI, Gemini, Cobalt, USDA, and RevenueCat integrations power enrichment, media handling, and monetization.",{"children":"OpenAI, Gemini, Cobalt, USDA, and RevenueCat integrations power enrichment, media handling, and monetization."}],["$","li","Server-authoritative feature gating and offline mutation queues keep planner workflows resilient.",{"children":"Server-authoritative feature gating and offline mutation queues keep planner workflows resilient."}]]}]]}],["$","div",null,{"className":"projectDetailBlock","children":[["$","p",null,{"className":"projectDetailLabel","children":"Design"}],["$","ul",null,{"className":"projectDetailList","children":[["$","li","Many capture paths are normalized into one recipe model so the product feels coherent instead of fragmented.",{"children":"Many capture paths are normalized into one recipe model so the product feels coherent instead of fragmented."}],["$","li","Planner and cooking flows are tuned for in-kitchen use with preview, swap, and large-step interactions.",{"children":"Planner and cooking flows are tuned for in-kitchen use with preview, swap, and large-step interactions."}]]}]]}]]}]
